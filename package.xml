<?xml version="1.0"?>
<package format="3">
  <name>rfid_sensor</name>
  <version>1.0.0</version>
  <description>Package for the RFID Gazebo plugin</description>
  <author email="salvatore.davella@santannapisa.it">Salvatore D'Avella</author>
  <maintainer email="salvatore.davella@santannapisa.it">Salvatore D'Avella</maintainer>
  <license>GNU GPL</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="lib"/>
  </export>
</package>
